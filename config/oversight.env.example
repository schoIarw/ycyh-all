# Copy to config/oversight.env, fill values, source using set -a.
PORT=8081
DB_URL='jdbc:postgresql://127.0.0.1:5432/oversight'
DB_USER=ycyh
DB_PASSWORD='replace-with-database-password'
OVERSIGHT_API_KEY='replace-with-same-random-key-at-least-24-characters'
OVERSIGHT_ADMIN_USER=approver
OVERSIGHT_ADMIN_PASSWORD='replace-with-approval-password-at-least-12-characters'
SSH_ALLOWED_HOSTS=192.168.10.11,192.168.10.12
SSH_ALLOWED_USERS=es
SSH_PRIVATE_KEY=/home/oversight/.ssh/id_ed25519
SSH_KNOWN_HOSTS=/home/oversight/.ssh/known_hosts
SSH_PORT=22
SSH_TIMEOUT_SECONDS=1200
