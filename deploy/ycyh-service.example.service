[Unit]
Description=YCYH oversight (copy and adapt for clustermgr)
After=network.target

[Service]
User=oversight
WorkingDirectory=/opt/ycyh-all
EnvironmentFile=/opt/ycyh-all/config/oversight.env
ExecStart=/usr/bin/java -jar /opt/ycyh-all/dist/oversight-0.1.0.jar
Restart=on-failure
RestartSec=10
UMask=0077
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
